{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://app-staging.bladevault.tkweb.site",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": ["GET", "HEAD", "PUT", "DELETE"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
