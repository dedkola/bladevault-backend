{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladevault-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "auth.tkweb.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bladevault",
      "database_id": "c8197b2b-bb48-4617-beab-69512252d986",
      "remote": true,
    },
  ],
  "vars": {
    "APP_NAME": "BladeVault",
    "AUTH_PUBLIC_BASE_URL": "https://auth.tkweb.dev",
    "ALLOWED_CLIENT_ORIGINS": "*",
    "COOKIE_DOMAIN": "",
  },
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ],
  },
}
