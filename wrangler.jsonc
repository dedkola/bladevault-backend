{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladevault-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "auth.bladevault.pro",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bladevault",
      "database_id": "c8197b2b-bb48-4617-beab-69512252d986",
      "remote": true
    }
  ],
  "vars": {
    "APP_NAME": "BladeVault",
    "AUTH_PUBLIC_BASE_URL": "https://auth.bladevault.pro",
    "ALLOWED_CLIENT_ORIGINS": "https://bladevault.pro,https://*.bladevault.pro,http://localhost:*,http://127.0.0.1:*",
    "COOKIE_DOMAIN": ".bladevault.pro"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
