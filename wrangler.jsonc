{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladevault-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bladevault",
      "database_id": "c8197b2b-bb48-4617-beab-69512252d986",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bladevault-backend",
      "remote": true,
    },
  ],
  "vars": {
    "APP_NAME": "BladeVault",
    "BETTER_AUTH_URL": "https://api-staging.tkweb.site",
    "CLOUDFLARE_ACCOUNT_ID": "73026fc18aa364a3cc60305b6c6fb75c",
    "COOKIE_DOMAIN": "",
    "CORS_ORIGIN": "https://app-staging.bladevault.tkweb.site,http://localhost:*,http://127.0.0.1:*",
    "FRONTEND_URL": "https://app-staging.bladevault.tkweb.site,http://localhost:*,http://127.0.0.1:*",
    "R2_BUCKET_NAME": "bladevault-backend",
    "R2_PUBLIC_BASE_URL": "https://r2.img.bladevault.backend.tkweb.site",
    "R2_SIGNED_URL_TTL_SECONDS": "300",
  },
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ],
  },
}
