# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
APP_NAME="BladeVault"
AUTH_PUBLIC_BASE_URL="https://auth.bladevault.pro"
ALLOWED_CLIENT_ORIGINS="https://bladevault.pro,https://*.bladevault.pro,http://localhost:*,http://127.0.0.1:*"
COOKIE_DOMAIN=".bladevault.pro"

# Secrets
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# Optional
# BETTER_AUTH_API_KEY="ba_replace_with_better_auth_dash_key"
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="development"
# SENTRY_RELEASE="local"
